{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "web/dashboard"
      ],
      "port": 8090
    },
    {
      "name": "guard-dashboard",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "guildward",
        "dashboard"
      ],
      "port": 8080,
      "env": {
        "DATABASE_PATH": "data/sim.db",
        "DASHBOARD_PORT": "8080"
      }
    }
  ]
}