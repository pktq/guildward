# Copy to .env and fill in. Never commit .env.
# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: a test server ID. Commands sync there instantly instead of globally (global can take up to 1h).
DEV_GUILD_ID=
# DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Path to the private rules package's src dir (e.g. ../guildward-private/src). Empty = public example rules.
GUILDWARD_PRIVATE=

# --- Guard (server mode of the same bot) -----------------------------------------------------
# Guard uses the same bot and token. For it to read servers that add it, turn on the privileged intents
# SERVER MEMBERS and MESSAGE CONTENT (Developer Portal -> your app -> Bot). The startup log prints three
# install links: kids' account install, server "checks only" (reads nothing), and full Guard.
# Where Guard keeps its database (SQLite). Never commit it.
DATABASE_PATH=data/guildward.db
# Dashboard. Admins sign in with /guard dashboard in Discord; the owner with `uv run guildward owner-link`.
DASHBOARD_URL=http://localhost:8080
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Optional fixed secret for sign-in links (otherwise one is generated and kept in the database).
DASHBOARD_SECRET=
# Your Discord user ID(s), comma-separated: these people see the bot-owner dashboard.
OWNER_IDS=

# --- Pocket app extras (all optional) ---------------------------------------------------------
# OAuth2 client secret of the pocket app (Developer Portal -> OAuth2). Turns on "/guildward scan"
# (kids let Guildward look over their server list). Add <DASHBOARD_URL>/pocket/callback as a redirect.
DISCORD_CLIENT_SECRET=
# Invite to the Guildward community server. Bots can only DM people they share a server with, so
# kids who want automatic alerts join it.
HOME_INVITE=
# Opt-in "Ask AI" second opinion on a checked message (Anthropic API key). Empty = button hidden.
ANTHROPIC_API_KEY=
# Google Safe Browsing API key for link checks. Empty = local checks + domain age only.
SAFE_BROWSING_KEY=
# Local message model (multilingual-e5-small, ~135 MB, downloaded once into data/models/, runs on this CPU, no text
# leaves the server). Set to off for rules only, e.g. on a box with under 1 GB RAM.
GUILDWARD_MODEL=
