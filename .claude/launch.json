{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dashboard-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "web/dashboard"
      ],
      "port": 8090
    },
    {
      "name": "wizard",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8092",
        "--directory",
        "web/wizard"
      ],
      "port": 8092
    },
    {
      "name": "guard-dashboard",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "guildward",
        "dashboard"
      ],
      "port": 8091,
      "env": {
        "DATABASE_PATH": "data/sim.db",
        "DASHBOARD_PORT": "8091",
        "DASHBOARD_URL": "http://localhost:3000"
      }
    }
  ]
}
